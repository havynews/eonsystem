# ─────────────────────────────────────────
#  E.ON System — Environment Variables
#  Copy this file to .env and fill in values
# ─────────────────────────────────────────

# Environment: development | testing | production
FLASK_ENV=development

# Secret key — change this to a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-very-secret-key-change-me

# ── Database ──────────────────────────────
# SQLite (default for dev)
DATABASE_URL=sqlite:///eonsystem.db
DEV_DATABASE_URL=sqlite:///eonsystem_dev.db
TEST_DATABASE_URL=sqlite:///:memory:

# PostgreSQL example (for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/eonsystem

# ── App ───────────────────────────────────
APP_NAME=E.ON System
APP_URL=http://localhost:5000

# ── Business Rules ────────────────────────
MIN_WITHDRAWAL_AMOUNT=70

# ── File Uploads ──────────────────────────
MAX_CONTENT_LENGTH=16777216   # 16MB in bytes
UPLOAD_FOLDER=app/static/uploads

# ── Mail (optional) ───────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_DEFAULT_SENDER=noreply@eonsystem.com
